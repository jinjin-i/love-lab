# 토스페이먼츠
TOSS_SECRET_KEY=test_sk_여기에_시크릿키_입력
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_여기에_클라이언트키_입력

# Firebase Admin (서버용)
FIREBASE_PROJECT_ID=여기에_프로젝트ID
FIREBASE_CLIENT_EMAIL=여기에_클라이언트이메일
FIREBASE_PRIVATE_KEY="여기에_프라이빗키_줄바꿈은_\\n으로"

# 사이트 도메인 (Vercel 배포 후 변경)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Anthropic
ANTHROPIC_API_KEY=여기에_클로드_API키

# 카카오 (카카오 개발자 콘솔 → 내 애플리케이션 → 앱 키 → JavaScript 키)
NEXT_PUBLIC_KAKAO_JS_KEY=여기에_카카오_JS키_입력
